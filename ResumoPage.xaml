<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.ResumoPage"
             Title="Resumo" BackgroundColor="{StaticResource Background}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Resumo do Evento" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Border BackgroundColor="White" Stroke="#DCE6F2" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="13">
                    <Label Text="{Binding Nome, StringFormat='Evento: {0}'}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />
                    <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" />
                    <Label Text="{Binding DuracaoFormatada, StringFormat='Duração: {0}'}" />
                    <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}" />
                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" />
                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C2}'}" />
                    <BoxView HeightRequest="1" Color="#DCE6F2" />
                    <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C2}'}"
                           FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="VOLTAR AO CADASTRO" Clicked="Voltar_Clicked"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
